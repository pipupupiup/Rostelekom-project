# Скопируйте в .env. Реальных секретов здесь нет.
ADO_TEAM=ADO
ADO_PORT=8080
ADO_LOG_LEVEL=info
POSTGRES_USER=ado
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ado
# Для запуска вне Docker (иначе задаётся в docker-compose.yml):
# ADO_DATABASE_URL=postgresql+psycopg://ado:change-me@localhost:5432/ado
# Линии маршрутов по дорогам на карте (только отображение; в оценке — матрица организаторов).
# GraphHopper: свой сервер (docker compose --profile graphhopper up -d) — значение по умолчанию в compose:
# ADO_GRAPHHOPPER_URL=http://graphhopper:8989
# или облачный GraphHopper Directions API (нужен ключ, данные уходят на graphhopper.com):
# ADO_GRAPHHOPPER_URL=https://graphhopper.com/api/1
# ADO_GRAPHHOPPER_KEY=...
# Альтернатива — OSRM (тогда ADO_GRAPHHOPPER_URL оставить пустым):
# ADO_OSRM_URL=http://osrm:5000
